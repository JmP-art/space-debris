\"NOV\"]\)  :  \>\"", ",", "inov"}], "]"}], ";", "\[IndentingNewLine]", 
         RowBox[{"Print", "[", 
          RowBox[{
          "\"\< \[Alpha] \[Congruent] \[Epsilon] :  \>\"", ",", "\[Alpha]"}], 
          "]"}], ";", "\[IndentingNewLine]", 
