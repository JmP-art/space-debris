--------------\>\"", "]"}], ";"}], "\[IndentingNewLine]", "}"}]}], "]"}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"Clear", "[", "eqns", "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"eqns", "=", 
      RowBox[{"{", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"x", "'"}], "[", "t", "]"}], "==", 
         RowBox[{"XDOT", "[", 
          RowBox[{
           RowBox[{"x", "[", "t", "]"}], ",", 
           RowBox[{"s", "[", "t", "]"}], ",", "b", ",", "el", ",", "eh", ",", 
           "\[Beta]low", ",", "\[Beta]high", ",", "low", ",", "high", ",", 
           "a", ",", "tauC", ",", "\[Beta]c", ",", "\[Sigma]Cost"}], "]"}]}], 
        ",", "\[IndentingNewLine]", 
        RowBox[{
