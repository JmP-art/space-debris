Cell[BoxData[
 RowBox[{
  RowBox[{"GenerateGRIDMultiInterval", "[", 
   RowBox[{
   "nGrid_", ",", "dGrid_", ",", "tLim_", ",", "IntervalWidth_", ",", 
    "precGoal_", ",", "filname_"}], "]"}], ":=", 
  RowBox[{"Module", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "i", ",", "j", ",", "ii", ",", "jj", ",", "xi", ",", "sj", ",", "st", 
      ",", 
      RowBox[{"isilent", "=", "0"}]}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      TemplateBox[{
        Cell[
         TextData["OpenWrite"]], "paclet:ref/OpenWrite"},
       "RefLink",
       BaseStyle->{"InlineFormula"}], "[", 
      StyleBox["filname",
       FontColor->GrayLevel[0.5]], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"st", "=", 
      RowBox[{"\"\<    \>\"", "<>", 
       RowBox[{"ToString", "[", "nGrid", "]"}], "<>", "\"\<      \>\"", "<>", 
       
       RowBox[{"ToString", "[", 
        RowBox[{"pr", "[", 
         RowBox[{"dGrid", ",", "4"}], "]"}], "]"}], "<>", "\"\<      \>\"", "<>", 
       RowBox[{"ToString", "[", "tLim", "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"WriteLine", "[", 
      RowBox[{"filname", ",", "st"}], "]"}], ";", " ", "\[IndentingNewLine]", 
     
     RowBox[{"For", "[", 
      RowBox[{
       RowBox[{"i", "=", "1"}], ",", 
       RowBox[{"i", "<", "nGrid"}], ",", 
       RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"For", "[", 
          RowBox[{
           RowBox[{"j", "=", "1"}], ",", 
           RowBox[{"j", "<", "nGrid"}], ",", 
           RowBox[{"j", "++"}], ",", "\[IndentingNewLine]", 
           RowBox[{"{", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"xi", "=", 
              RowBox[{"i", "*", "dGrid"}]}], ";", "\[IndentingNewLine]", 
             RowBox[{"sj", "=", 
              RowBox[{"j", "*", "dGrid"}]}], ";", "\[IndentingNewLine]", 
             RowBox[{"(*", "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{"st", "=", 
                RowBox[{"\"\<    \>\"", "<>", 
                 RowBox[{"ToString", "[", 
                  RowBox[{"pr", "[", 
                   RowBox[{"xi", ",", "4"}], "]"}], "]"}], "<>", 
                 "\"\<      \>\"", "<>", 
                 RowBox[{"ToString", "[", 
                  RowBox[{"pr", "[", 
                   RowBox[{"sj", ",", "4"}], "]"}], "]"}]}]}], ";", 
               "\[IndentingNewLine]", 
               RowBox[{"WriteLine", "[", 
                RowBox[{"filname", ",", "st"}], "]"}], ";"}], " ", "*)"}], 
             "\[IndentingNewLine]", 
             RowBox[{"Quiet", "[", 
              RowBox[{"TimeEvolutionMultiInterval", "[", 
               RowBox[{
               "isilent", ",", "xi", ",", "sj", ",", "tLim", ",", 
                "IntervalWidth", ",", "precGoal", ",", "filname"}], "]"}], 
              "]"}], ";"}], "\[IndentingNewLine]", "}"}]}], 
          "\[IndentingNewLine]", "]"}], ";"}], "\[IndentingNewLine]", "}"}]}],
       "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"Close", "[", 
      StyleBox["filname",
       FontColor->GrayLevel[0.5]], "]"}], ";"}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
