--------------\>\"", "]"}], ";"}], "\[IndentingNewLine]", "}"}]}], "]"}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"Clear", "[", "eqns", "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"eqns", "=", 
      RowBox[{"{", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"x", "'"}], "[", "t", "]"}], "==", 
