            "inov", ",", "\[Alpha]"}], "]"}]}]}], ",", "\[IndentingNewLine]", 
        
        RowBox[{
         RowBox[{"x", "[", "0", "]"}], "\[Equal]", "x0"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"s", "[", "0", "]"}], "\[Equal]", "s0"}]}], 
       "\[IndentingNewLine]", "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"vars", "=", 
      RowBox[{"{", 
       RowBox[{"x", ",", "s"}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"solns", "=", 
      RowBox[{"Quiet", "@", 
       RowBox[{"NDSolve", "[", 
        RowBox[{"eqns", ",", "vars", ",", 
         RowBox[{"{", 
          RowBox[{"t", ",", "0", ",", "tlim"}], "}"}], ",", 
         RowBox[{"WorkingPrecision", "\[Rule]", "pg"}], ",", 
         RowBox[{"PrecisionGoal", "\[Rule]", "\[Infinity]"}]}], "]"}]}]}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"x0", ",", "\"\<      \>\"", ",", "s0"}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"x", "[", "tlim", "]"}], "/.", "solns"}], ",", 
