         RowBox[{"{", 
          RowBox[{"i", ",", "1", ",", "nIntervals"}], "}"}]}], "]"}], "]"}]}],
      ";", "\[IndentingNewLine]", 
     RowBox[{"P1", "=", 
      RowBox[{"Quiet", "[", 
       RowBox[{"combiSolx", "[", "tlim", "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"P2", "=", 
      RowBox[{"Quiet", "[", 
