Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"nilpower", "[", 
    RowBox[{"a_", ",", "b_"}], "]"}], ":=", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{"b", "==", "0.0"}], ",", "1", ",", 
     SuperscriptBox["a", "b"]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"mypower", "[", 
    RowBox[{"a_", ",", "b_"}], "]"}], ":=", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{"b", "<", "1"}], ",", "1", ",", 
     SuperscriptBox["a", "b"]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"step", "[", "x_", "]"}], ":=", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{"x", "<", "0"}], ",", "0.", ",", "1."}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Fermido", "[", 
    RowBox[{"x_", ",", "a_", ",", "\[Beta]_"}], "]"}], ":=", 
   FractionBox["1", 
    RowBox[{"1", "+", 
     SuperscriptBox["\[ExponentialE]", 
      RowBox[{"\[Beta]", 
       RowBox[{"(", 
        RowBox[{"x", "-", "a"}], ")"}]}]]}]]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Fermiup", "[", 
    RowBox[{"x_", ",", "a_", ",", "\[Beta]_"}], "]"}], ":=", 
   FractionBox["1", 
    RowBox[{"1", "+", 
     SuperscriptBox["\[ExponentialE]", 
      RowBox[{
       RowBox[{"-", "\[Beta]"}], 
       RowBox[{"(", 
        RowBox[{"x", "-", "a"}], ")"}]}]]}]]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"fstep", "[", 
    RowBox[{
    "x_", ",", "el_", ",", "eh_", ",", "a_", ",", "b_", ",", "\[Beta]1_", ",",
      "\[Beta]2_"}], "]"}], ":=", " ", 
   RowBox[{
    RowBox[{"nilpower", "[", 
     RowBox[{"x", ",", "el"}], "]"}], "*", 
    RowBox[{"nilpower", "[", 
     RowBox[{
      RowBox[{"1", "-", "x"}], ",", "eh"}], "]"}], "*", " ", 
    RowBox[{"Fermiup", "[", 
     RowBox[{"x", ",", "a", ",", "\[Beta]1"}], "]"}], "*", 
    RowBox[{"Fermido", "[", 
     RowBox[{"x", ",", "b", ",", "\[Beta]2"}], "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"fFactor", "[", 
    RowBox[{
    "el_", ",", "eh_", ",", "p_", ",", "q_", ",", "\[Beta]1_", ",", 
     "\[Beta]2_"}], "]"}], ":=", 
   RowBox[{"NIntegrate", "[", 
    RowBox[{
     RowBox[{"fstep", "[", 
      RowBox[{
      "x", ",", "el", ",", "eh", ",", "p", ",", "q", ",", "\[Beta]1", ",", 
       "\[Beta]2"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", "0", ",", "1"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"PreFactor", "[", 
    RowBox[{
    "x_", ",", "el_", ",", "eh_", ",", "p_", ",", "q_", ",", "\[Beta]L_", ",",
      "\[Beta]H_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"fstep", "[", 
     RowBox[{
     "x", ",", "el", ",", "eh", ",", "p", ",", "q", ",", "\[Beta]L", ",", 
      "\[Beta]H"}], "]"}], "/", 
    RowBox[{"fFactor", "[", 
     RowBox[{
     "el", ",", "eh", ",", "p", ",", "q", ",", "\[Beta]L", ",", "\[Beta]H"}], 
     "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"ben", "[", 
    RowBox[{
    "s_", ",", "b_", ",", "el_", ",", "eh_", ",", "p_", ",", "q_", ",", 
     "\[Beta]low_", ",", "\[Beta]high_"}], "]"}], ":=", 
   RowBox[{"b", "*", 
    RowBox[{"PreFactor", "[", 
     RowBox[{
     "s", ",", "el", ",", "eh", ",", "p", ",", "q", ",", "\[Beta]low", ",", 
      "\[Beta]high"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"ccost", "[", 
    RowBox[{
    "s_", ",", "a_", ",", "c_", ",", "\[Beta]_", " ", ",", "\[Sigma]_"}], 
    "]"}], ":=", 
   RowBox[{"a", "+", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"1", "-", "a"}], ")"}], "*", 
     RowBox[{"Fermiup", "[", 
      RowBox[{"s", ",", "c", ",", "\[Beta]"}], "]"}], "*", 
     SuperscriptBox[
      RowBox[{"(", "s", ")"}], "\[Sigma]"]}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"cFactor", "[", 
    RowBox[{"a_", ",", "c_", ",", "\[Beta]_", " ", ",", "\[Sigma]_"}], "]"}], 
   ":=", 
   RowBox[{"NIntegrate", "[", 
    RowBox[{
     RowBox[{"ccost", "[", 
      RowBox[{"s", ",", "a", ",", "c", ",", "\[Beta]", " ", ",", "\[Sigma]"}],
       "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"s", ",", "0", ",", "1"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"cost", "[", 
    RowBox[{
    "s_", ",", "a_", ",", "c_", ",", "\[Beta]_", " ", ",", "\[Sigma]_"}], 
    "]"}], ":=", 
   RowBox[{
    RowBox[{"ccost", "[", 
     RowBox[{"s", ",", "a", ",", "c", ",", "\[Beta]", " ", ",", "\[Sigma]"}], 
     "]"}], "/", 
    RowBox[{"cFactor", "[", 
     RowBox[{"a", ",", "c", ",", "\[Beta]", " ", ",", "\[Sigma]"}], "]"}]}]}],
   ";"}]}], "Input",
 CellGroupingRules->{"GroupTogetherGrouping", 10002.},
