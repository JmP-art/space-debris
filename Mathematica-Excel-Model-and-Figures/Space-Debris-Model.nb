        RowBox[{
         RowBox[{"s", "[", "0", "]"}], "\[Equal]", "s0"}]}], 
       "\[IndentingNewLine]", "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"vars", "=", 
      RowBox[{"{", 
       RowBox[{"x", ",", "s"}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"solns", "=", 
      RowBox[{"Quiet", "@", 
       RowBox[{"NDSolve", "[", 
        RowBox[{"eqns", ",", "vars", ",", 
         RowBox[{"{", 
          RowBox[{"t", ",", "0", ",", "tlim"}], "}"}], ",", 
         RowBox[{"WorkingPrecision", "\[Rule]", "pg"}], ",", 
         RowBox[{"PrecisionGoal", "\[Rule]", "\[Infinity]"}], ",", 
         RowBox[{"MaxStepFraction", "->", "1"}], ",", 
         RowBox[{"InterpolationOrder", "\[Rule]", "All"}], ",", 
         RowBox[{"Method", "->", 
          RowBox[{"{", 
           RowBox[{"\"\<FixedStep\>\"", ",", 
            RowBox[{"Method", "->", 
