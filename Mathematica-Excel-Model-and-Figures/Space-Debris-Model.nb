--------------\>\"", "]"}], ";"}], "\[IndentingNewLine]", "}"}]}], "]"}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"Clear", "[", "eqns", "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"eqns", "=", 
      RowBox[{"{", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"x", "'"}], "[", "t", "]"}], "==", 
         RowBox[{"XDOT", "[", 
          RowBox[{
           RowBox[{"x", "[", "t", "]"}], ",", 
           RowBox[{"s", "[", "t", "]"}], ",", "b", ",", "el", ",", "eh", ",", 
           "\[Beta]low", ",", "\[Beta]high", ",", "low", ",", "high", ",", 
           "a", ",", "tauC", ",", "\[Beta]c", ",", "\[Sigma]Cost"}], "]"}]}], 
        ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"s", "'"}], "[", "t", "]"}], "\[Equal]", 
         RowBox[{"Ts", "*", 
          RowBox[{"SDOT", "[", 
           RowBox[{
            RowBox[{"x", "[", "t", "]"}], ",", 
            RowBox[{"s", "[", "t", "]"}], ",", "rlim", ",", "\[Lambda]", ",", 
            "inov", ",", "\[Alpha]"}], "]"}]}]}], ",", "\[IndentingNewLine]", 
        
        RowBox[{
