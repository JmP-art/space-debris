       "\"\<      \>\"", "<>", "\[IndentingNewLine]", 
       RowBox[{"ToString", "[", 
        RowBox[{"pr", "[", 
         RowBox[{"timm", ",", "2"}], "]"}], "]"}], "<>", 
       "\[IndentingNewLine]", "\"\<      \>\"", "<>", "\[IndentingNewLine]", 
