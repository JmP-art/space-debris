        "**", "**", "**", "**", "**", "**", "**", "**", "**", "**", "**", "**",
        "**", "**", "**", "**", "**", "**", "**", "**", "**", "**", "**", "**",
        "**", "**", "**", "**", "**"}], "******)"}], "\[IndentingNewLine]", 
     RowBox[{"st", "=", 
      RowBox[{"\"\<    \>\"", "<>", "\[IndentingNewLine]", 
