Cell[BoxData[
 RowBox[{
  RowBox[{"RKEvolution", "[", 
   RowBox[{
   "isilent_", ",", "x0_", ",", "s0_", ",", "tlim_", ",", "precgoal_", ",", 
    "filname_"}], "]"}], ":=", 
  RowBox[{"Module", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "gv0", ",", "gv", ",", "pl1", ",", "pl2", ",", "pl3", ",", "b", ",", 
      "el", ",", "eh", ",", "low", ",", "high", ",", "\[Beta]low", ",", 
      "\[Beta]high", ",", "x", ",", "s", ",", "c0", ",", "a", ",", "tauC", 
      ",", "\[Beta]c", ",", "\[Sigma]Cost", ",", "rlim", ",", "Ts", ",", 
      "\[Lambda]", ",", "inov", ",", "\[Alpha]", ",", "eqns", ",", "vars", 
      ",", "solns", ",", "t", ",", "timm", ",", "IFL1", ",", "IFL2", ",", 
      "P1", ",", "P2", ",", 
      RowBox[{"eps1", "=", "0.01"}], ",", "WX", ",", "WS", ",", "st", ",", 
      "pg"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"pg", "=", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"precgoal", "==", "0"}], ",", "16.0", ",", "precgoal"}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"gv0", "=", 
      RowBox[{"Import", "[", "\"\<config.dat\>\"", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"gv", "=", 
      RowBox[{"ToExpression", "[", 
       RowBox[{"Flatten", "[", "gv0", "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"**", " ", "benefit"}], " ", "parameters"}], " ", "***)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"b", "=", 
      RowBox[{"gv", "[", 
       RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"el", "=", 
      RowBox[{"gv", "[", 
       RowBox[{"[", "2", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"eh", "=", 
      RowBox[{"gv", "[", 
       RowBox[{"[", "3", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"low", "=", 
      RowBox[{"gv", "[", 
       RowBox[{"[", "4", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"high", "=", 
      RowBox[{"gv", "[", 
       RowBox[{"[", "5", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"\[Beta]low", "=", 
      RowBox[{"gv", "[", 
       RowBox[{"[", "6", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"\[Beta]high", "=", 
      RowBox[{"gv", "[", 
       RowBox[{"[", "7", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"**", " ", "cost"}], " ", "parameters"}], " ", "***)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"a", "=", 
      RowBox[{"gv", "[", 
       RowBox[{"[", "8", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"tauC", "=", 
      RowBox[{"gv", "[", 
       RowBox[{"[", "9", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"\[Beta]c", "=", 
      RowBox[{"gv", "[", 
       RowBox[{"[", "10", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"\[Sigma]Cost", "=", 
      RowBox[{"gv", "[", 
       RowBox[{"[", "11", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"**", " ", "relative"}], " ", "time", " ", "scale", "  ", 
       "parameter"}], " ", "***)"}], "\[IndentingNewLine]", 
     RowBox[{"Ts", "=", 
      RowBox[{"gv", "[", 
       RowBox[{"[", "12", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"**", " ", "Sdot"}], " ", "parameters"}], " ", "***)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"rlim", "=", 
      RowBox[{"gv", "[", 
       RowBox[{"[", "13", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"\[Lambda]", "=", 
      RowBox[{"gv", "[", 
       RowBox[{"[", "14", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"inov", "=", 
      RowBox[{"gv", "[", 
       RowBox[{"[", "15", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"\[Alpha]", "=", 
      RowBox[{"gv", "[", 
       RowBox[{"[", "16", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"isilent", ">", "0"}], ",", "\[IndentingNewLine]", 
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
         "Print", "[", 
          "\"\<---------------------------------------------------------------\
--------------\>\"", "]"}], ";", "\[IndentingNewLine]", 
         RowBox[{
         "Print", "[", "\"\<  Parameters used for benefit(s) :  \>\"", "]"}], 
         ";", "\[IndentingNewLine]", 
         RowBox[{"Print", "[", 
          RowBox[{"\"\<  b    :  \>\"", ",", "b"}], "]"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"Print", "[", 
          RowBox[{
          "\"\<  \!\(\*SubscriptBox[\(s\), \(L\)]\)   :  \>\"", ",", "el"}], 
          "]"}], ";", "\[IndentingNewLine]", 
         RowBox[{"Print", "[", 
          RowBox[{
          "\"\<  \!\(\*SubscriptBox[\(s\), \(R\)]\)   :  \>\"", ",", "eh"}], 
          "]"}], ";", "\[IndentingNewLine]", 
         RowBox[{"Print", "[", 
          RowBox[{
          "\"\<  \!\(\*SubscriptBox[\(\[Beta]\), \(L\)]\)   :  \>\"", ",", 
           "\[Beta]low"}], "]"}], ";", "\[IndentingNewLine]", 
         RowBox[{"Print", "[", 
          RowBox[{
          "\"\<  \!\(\*SubscriptBox[\(\[Tau]\), \(L\)]\)   :  \>\"", ",", 
           "low"}], "]"}], ";", "\[IndentingNewLine]", 
         RowBox[{"Print", "[", 
          RowBox[{
          "\"\<  \!\(\*SubscriptBox[\(\[Beta]\), \(R\)]\)   :  \>\"", ",", 
           "\[Beta]high"}], "]"}], ";", "\[IndentingNewLine]", 
         RowBox[{"Print", "[", 
          RowBox[{
          "\"\<  \!\(\*SubscriptBox[\(\[Tau]\), \(R\)]\)   :  \>\"", ",", 
           "high"}], "]"}], ";", "\[IndentingNewLine]", 
         RowBox[{
         "Print", "[", "\"\<-------------------------------\>\"", "]"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{
         "Print", "[", "\"\<  Parameters used for cost(s) :  \>\"", "]"}], 
         ";", "\[IndentingNewLine]", 
         RowBox[{"Print", "[", 
          RowBox[{"\"\<  c    :  \>\"", ",", "1"}], "]"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"Print", "[", 
          RowBox[{"\"\<  a    :  \>\"", ",", "a"}], "]"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"Print", "[", 
          RowBox[{
          "\"\<  \!\(\*SubscriptBox[\(s\), \(c\)]\)   :  \>\"", ",", 
           "\[Sigma]Cost"}], "]"}], ";", "\[IndentingNewLine]", 
         RowBox[{"Print", "[", 
          RowBox[{
          "\"\<  \!\(\*SubscriptBox[\(\[Beta]\), \(c\)]\)   :  \>\"", ",", 
           "\[Beta]c"}], "]"}], ";", "\[IndentingNewLine]", 
         RowBox[{"Print", "[", 
          RowBox[{
          "\"\<  \!\(\*SubscriptBox[\(\[Tau]\), \(c\)]\)   :  \>\"", ",", 
           "tauC"}], "]"}], ";", "\[IndentingNewLine]", 
         RowBox[{
         "Print", "[", "\"\<-------------------------------\>\"", "]"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{
         "Print", "[", 
          "\"\<  Parameters used for \!\(\*OverscriptBox[\(S\), \
\(.\)]\)(s,x)) :  \>\"", "]"}], ";", "\[IndentingNewLine]", 
         RowBox[{"Print", "[", 
          RowBox[{
          "\"\<  \!\(\*SubscriptBox[\(T\), \(s\)]\)   :  \>\"", ",", "Ts"}], 
          "]"}], ";", "\[IndentingNewLine]", 
         RowBox[{"Print", "[", 
          RowBox[{
          "\"\<  \!\(\*SubscriptBox[StyleBox[\"r\",FontSlant->\"Italic\"], \
\"LIM\"]\)  :  \>\"", ",", "rlim"}], "]"}], ";", "\[IndentingNewLine]", 
         RowBox[{"Print", "[", 
          RowBox[{"\"\<  \[Lambda]    :  \>\"", ",", "\[Lambda]"}], "]"}], 
         ";", "\[IndentingNewLine]", 
         RowBox[{"Print", "[", 
          RowBox[{
          "\"\<  \!\(\*SubscriptBox[StyleBox[\"i\",FontSlant->\"Italic\"], \
\"NOV\"]\)  :  \>\"", ",", "inov"}], "]"}], ";", "\[IndentingNewLine]", 
         RowBox[{"Print", "[", 
          RowBox[{
          "\"\< \[Alpha] \[Congruent] \[Epsilon] :  \>\"", ",", "\[Alpha]"}], 
          "]"}], ";", "\[IndentingNewLine]", 
         RowBox[{
         "Print", "[", 
          "\"\<---------------------------------------------------------------\
--------------\>\"", "]"}], ";"}], "\[IndentingNewLine]", "}"}]}], "]"}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"Clear", "[", "eqns", "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"eqns", "=", 
      RowBox[{"{", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"x", "'"}], "[", "t", "]"}], "==", 
         RowBox[{"XDOT", "[", 
          RowBox[{
           RowBox[{"x", "[", "t", "]"}], ",", 
           RowBox[{"s", "[", "t", "]"}], ",", "b", ",", "el", ",", "eh", ",", 
           "\[Beta]low", ",", "\[Beta]high", ",", "low", ",", "high", ",", 
           "a", ",", "tauC", ",", "\[Beta]c", ",", "\[Sigma]Cost"}], "]"}]}], 
        ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"s", "'"}], "[", "t", "]"}], "\[Equal]", 
         RowBox[{"Ts", "*", 
          RowBox[{"SDOT", "[", 
           RowBox[{
            RowBox[{"x", "[", "t", "]"}], ",", 
            RowBox[{"s", "[", "t", "]"}], ",", "rlim", ",", "\[Lambda]", ",", 
            "inov", ",", "\[Alpha]"}], "]"}]}]}], ",", "\[IndentingNewLine]", 
        
        RowBox[{
         RowBox[{"x", "[", "0", "]"}], "\[Equal]", "x0"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"s", "[", "0", "]"}], "\[Equal]", "s0"}]}], 
       "\[IndentingNewLine]", "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"vars", "=", 
      RowBox[{"{", 
       RowBox[{"x", ",", "s"}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"solns", "=", 
      RowBox[{"Quiet", "@", 
       RowBox[{"NDSolve", "[", 
        RowBox[{"eqns", ",", "vars", ",", 
         RowBox[{"{", 
          RowBox[{"t", ",", "0", ",", "tlim"}], "}"}], ",", 
         RowBox[{"WorkingPrecision", "\[Rule]", "pg"}], ",", 
         RowBox[{"PrecisionGoal", "\[Rule]", "\[Infinity]"}], ",", 
         RowBox[{"MaxStepFraction", "->", "1"}], ",", 
         RowBox[{"InterpolationOrder", "\[Rule]", "All"}], ",", 
         RowBox[{"Method", "->", 
          RowBox[{"{", 
           RowBox[{"\"\<FixedStep\>\"", ",", 
            RowBox[{"Method", "->", 
             RowBox[{"{", 
              RowBox[{"\"\<ExplicitRungeKutta\>\"", ",", 
               RowBox[{"\"\<DifferenceOrder\>\"", "->", "Automatic"}]}], 
              "}"}]}]}], "}"}]}]}], "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"P1", "=", 
      RowBox[{"First", "[", 
       RowBox[{
        RowBox[{"x", "[", "tlim", "]"}], "/.", "solns"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"P2", "=", 
      RowBox[{"First", "[", 
       RowBox[{
        RowBox[{"s", "[", "tlim", "]"}], "/.", "solns"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"WX", "=", 
      RowBox[{"Re", "[", 
       RowBox[{"P1", "[", 
        RowBox[{"[", "1", "]"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"WS", "=", 
      RowBox[{"Re", "[", 
       RowBox[{"P2", "[", 
        RowBox[{"[", "1", "]"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"timm", "=", "tlim"}], ";", "\[IndentingNewLine]", 
     RowBox[{"st", "=", 
      RowBox[{"\"\<    \>\"", "<>", "\[IndentingNewLine]", 
       RowBox[{"ToString", "[", 
        RowBox[{"pr", "[", 
         RowBox[{"x0", ",", "2"}], "]"}], "]"}], "<>", "\[IndentingNewLine]", 
       "\"\<      \>\"", "<>", "\[IndentingNewLine]", 
       RowBox[{"ToString", "[", 
        RowBox[{"pr", "[", 
         RowBox[{"s0", ",", "2"}], "]"}], "]"}], "<>", "\[IndentingNewLine]", 
       "\"\<      \>\"", "<>", "\[IndentingNewLine]", 
       RowBox[{"ToString", "[", 
        RowBox[{"pr", "[", 
         RowBox[{"timm", ",", "2"}], "]"}], "]"}], "<>", 
       "\[IndentingNewLine]", "\"\<      \>\"", "<>", "\[IndentingNewLine]", 
       RowBox[{"ToString", "[", 
        RowBox[{"pr", "[", 
         RowBox[{"WX", ",", "6"}], "]"}], "]"}], "<>", "\[IndentingNewLine]", 
       "\"\<     \>\"", "<>", "\[IndentingNewLine]", 
       RowBox[{"ToString", "[", 
        RowBox[{"pr", "[", 
         RowBox[{"WS", ",", "6"}], "]"}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"Print", "[", "st", "]"}], ";"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"WriteLine", "[", 
      RowBox[{"filname", ",", "st"}], "]"}], ";"}]}], " ", 
   "\[IndentingNewLine]", "]"}]}]], "Input",
