                  RowBox[{"P1", "[", 
                   RowBox[{"[", "1", "]"}], "]"}], "]"}]}], ";", 
                RowBox[{"WS", "=", 
                 RowBox[{"Re", "[", 
                  RowBox[{"P2", "[", 
                   RowBox[{"[", "1", "]"}], "]"}], "]"}]}], ";", 
                RowBox[{"timm", "=", "t"}]}], "}"}]}], "]"}], ";"}], 
           "\[IndentingNewLine]", "}"}]}], "\[IndentingNewLine]", "]"}], 
