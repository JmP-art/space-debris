Cell[BoxData[
 RowBox[{
  RowBox[{"RanScanConfigsRestart", "[", 
   RowBox[{
   "nroots_", ",", "nlim_", ",", "nstart_", ",", "filname_", ",", "njump_", 
    ",", "Ts_", ",", "rlim_", ",", "\[Lambda]_", ",", "inov_", ",", 
    "\[Alpha]_"}], "]"}], ":=", 
  RowBox[{"Module", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "kount", ",", "idec", ",", "kmax", ",", "kaux", ",", "ptmp", ",", "nmax",
       ",", "i", ",", "disp"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"idec", "=", "0"}], ";", "\[IndentingNewLine]", 
     RowBox[{"kount", "=", "0"}], ";", "\[IndentingNewLine]", 
     RowBox[{"LoadParameters", "[", 
      RowBox[{"0", ",", "nroots"}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"Do", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"kount", "++"}], ";", "\[IndentingNewLine]", 
         RowBox[{"ReadParametersDummy", "[", "filname", "]"}], ";"}], 
        "\[IndentingNewLine]", "}"}], ",", 
       RowBox[{"nstart", "-", "1"}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<<  start at config #  > =   \>\"", ",", "nstart"}], "]"}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<<    configs jumped   > =   \>\"", ",", "njump"}], "]"}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{"disp", "=", 
      RowBox[{
       RowBox[{"IntegerPart", "[", 
        RowBox[{"njump", "/", "6"}], "]"}], "+", "1"}]}], ";", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<<      var jumps      > =   \>\"", ",", "disp"}], "]"}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{"nmax", "=", 
      RowBox[{
       RowBox[{"IntegerPart", "[", 
        RowBox[{"nlim", "/", "njump"}], "]"}], "+", "1"}]}], ";", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<< ner-configs-sampled > =   \>\"", ",", "nmax"}], "]"}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{"kount", "++"}], ";", 
     RowBox[{"Print", "[", 
      RowBox[{
      "\"\< \!\(\*StyleBox[\"config\",FontColor->RGBColor[1, 0, \
1]]\)\!\(\*StyleBox[\" \",FontColor->RGBColor[1, 0, \
1]]\)\!\(\*StyleBox[\"#\",FontColor->RGBColor[1, 0, 1]]\)\!\(\*StyleBox[\"   \
\",FontColor->RGBColor[1, 0, 1]]\)\!\(\*StyleBox[\":\",FontColor->RGBColor[1, \
0, 1]]\)\!\(\*StyleBox[\"     \",FontColor->RGBColor[1, 0, 1]]\)\>\"", ",", 
       "kount"}], "]"}], ";", 
     RowBox[{"ReadParameters", "[", 
      RowBox[{"1", ",", 
       StyleBox["1",
        FontColor->RGBColor[0, 1, 0]], ",", "filname", ",", "Ts", ",", "rlim",
        ",", "\[Lambda]", ",", "inov", ",", "\[Alpha]"}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"RootsReport", "[", "0", "]"}], ";", 
     RowBox[{"ptmp", "=", 
      RowBox[{"Plot2D", "[", 
       RowBox[{"0", ",", "1"}], "]"}]}], ";", 
     RowBox[{"CellPrint", "[", 
      RowBox[{"TextCell", "[", 
       RowBox[{
        RowBox[{"Show", "[", "ptmp", "]"}], ",", "\"\<Text\>\""}], "]"}], 
      "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"For", "[", 
      RowBox[{
       RowBox[{"i", "=", "1"}], ",", 
       RowBox[{"i", "<=", "nmax"}], ",", 
       RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"{", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"idec", "==", "0"}], ",", "\[IndentingNewLine]", 
            RowBox[{"{", " ", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"kaux", "=", 
               RowBox[{"RandomInteger", "[", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"njump", "-", "disp"}], ",", 
                  RowBox[{"njump", "+", "disp"}]}], "}"}], "]"}]}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"kaux", "+", "kount"}], ">=", "nlim"}], ",", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"idec", "=", "1"}], ";", 
                  RowBox[{"kaux", "=", 
                   RowBox[{"nlim", "-", "kount", "-", "1"}]}], ";", 
                  RowBox[{"Print", "[", 
                   RowBox[{"\"\<  kaux =  \>\"", ",", "kaux"}], "]"}]}], 
                 "}"}]}], "]"}], ";", "\[IndentingNewLine]", 
              RowBox[{"Do", "[", "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{"{", "\[IndentingNewLine]", 
                 RowBox[{
                  RowBox[{"kount", "++"}], ";", "\[IndentingNewLine]", 
                  RowBox[{"ReadParametersDummy", "[", "filname", "]"}], ";"}],
                  "\[IndentingNewLine]", "}"}], ",", "kaux"}], "]"}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"kount", "++"}], ";", "\[IndentingNewLine]", 
              RowBox[{"Print", "[", 
               RowBox[{
               "\"\< \!\(\*StyleBox[\"config\",FontColor->RGBColor[1, 0, \
1]]\)\!\(\*StyleBox[\" \",FontColor->RGBColor[1, 0, \
1]]\)\!\(\*StyleBox[\"#\",FontColor->RGBColor[1, 0, 1]]\)\!\(\*StyleBox[\"   \
\",FontColor->RGBColor[1, 0, 1]]\)\!\(\*StyleBox[\":\",FontColor->RGBColor[1, \
0, 1]]\)\!\(\*StyleBox[\"     \",FontColor->RGBColor[1, 0, 1]]\)\>\"", ",", 
                "kount"}], "]"}], ";", 
              RowBox[{"ReadParameters", "[", 
               RowBox[{"1", ",", 
                StyleBox["1",
                 FontColor->RGBColor[0, 1, 0]], ",", "filname", ",", "Ts", 
                ",", "rlim", ",", "\[Lambda]", ",", "inov", ",", "\[Alpha]"}],
                "]"}], ";", "\[IndentingNewLine]", 
              RowBox[{"RootsReport", "[", "0", "]"}], ";", 
              RowBox[{"ptmp", "=", 
               RowBox[{"Plot2D", "[", 
                RowBox[{"0", ",", "1"}], "]"}]}], ";", 
              RowBox[{"CellPrint", "[", 
               RowBox[{"TextCell", "[", 
                RowBox[{
                 RowBox[{"Show", "[", "ptmp", "]"}], ",", "\"\<Text\>\""}], 
                "]"}], "]"}], ";"}], "\[IndentingNewLine]", "}"}]}], 
           "\[IndentingNewLine]", "]"}], ";"}], "\[IndentingNewLine]", "}"}], 
        ";"}]}], "\[IndentingNewLine]", "]"}], ";"}]}], "\[IndentingNewLine]",
    "]"}]}]], "Input",
