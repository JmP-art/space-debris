       RowBox[{"[", "15", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"\[Alpha]", "=", 
      RowBox[{"gv", "[", 
       RowBox[{"[", "16", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"isilent", ">", "0"}], ",", "\[IndentingNewLine]", 
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
         "Print", "[", 
          "\"\<---------------------------------------------------------------\
--------------\>\"", "]"}], ";", "\[IndentingNewLine]", 
         RowBox[{
         "Print", "[", "\"\<  Parameters used for benefit(s) :  \>\"", "]"}], 
         ";", "\[IndentingNewLine]", 
         RowBox[{"Print", "[", 
          RowBox[{"\"\<  b    :  \>\"", ",", "b"}], "]"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"Print", "[", 
