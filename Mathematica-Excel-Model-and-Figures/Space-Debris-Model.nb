Cell[BoxData[
 RowBox[{
  RowBox[{"TimeEvolution", "[", 
   RowBox[{
   "isilent_", ",", "x0_", ",", "s0_", ",", "tlim_", ",", "precgoal_", ",", 
    "filname_"}], "]"}], ":=", 
  RowBox[{"Module", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "gv0", ",", "gv", ",", "pl1", ",", "pl2", ",", "pl3", ",", "b", ",", 
      "el", ",", "eh", ",", "low", ",", "high", ",", "\[Beta]low", ",", 
      "\[Beta]high", ",", "x", ",", "s", ",", "c0", ",", "a", ",", "tauC", 
      ",", "\[Beta]c", ",", "\[Sigma]Cost", ",", "rlim", ",", "Ts", ",", 
      "\[Lambda]", ",", "inov", ",", "\[Alpha]", ",", "eqns", ",", "vars", 
      ",", "solns", ",", "t", ",", "timm", ",", "IFL1", ",", "IFL2", ",", 
      "P1", ",", "P2", ",", 
      RowBox[{"eps1", "=", "0.01"}], ",", "WX", ",", "WS", ",", "st", ",", 
      "pg"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"pg", "=", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"precgoal", "==", "0"}], ",", "50.0", ",", "precgoal"}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"gv0", "=", 
      RowBox[{"Import", "[", "\"\<config.dat\>\"", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"gv", "=", 
