       RowBox[{"[", "4", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"high", "=", 
      RowBox[{"gv", "[", 
       RowBox[{"[", "5", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"\[Beta]low", "=", 
      RowBox[{"gv", "[", 
       RowBox[{"[", "6", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"\[Beta]high", "=", 
      RowBox[{"gv", "[", 
       RowBox[{"[", "7", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"**", " ", "cost"}], " ", "parameters"}], " ", "***)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"a", "=", 
      RowBox[{"gv", "[", 
       RowBox[{"[", "8", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"tauC", "=", 
      RowBox[{"gv", "[", 
