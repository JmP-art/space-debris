         RowBox[{
         "Print", "[", 
          "\"\<---------------------------------------------------------------\
--------------\>\"", "]"}], ";"}], "\[IndentingNewLine]", "}"}]}], "]"}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"Clear", "[", "eqns", "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"eqns", "=", 
      RowBox[{"{", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"x", "'"}], "[", "t", "]"}], "==", 
         RowBox[{"XDOT", "[", 
          RowBox[{
           RowBox[{"x", "[", "t", "]"}], ",", 
           RowBox[{"s", "[", "t", "]"}], ",", "b", ",", "el", ",", "eh", ",", 
           "\[Beta]low", ",", "\[Beta]high", ",", "low", ",", "high", ",", 
           "a", ",", "tauC", ",", "\[Beta]c", ",", "\[Sigma]Cost"}], "]"}]}], 
        ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"s", "'"}], "[", "t", "]"}], "\[Equal]", 
         RowBox[{"Ts", "*", 
          RowBox[{"SDOT", "[", 
           RowBox[{
            RowBox[{"x", "[", "t", "]"}], ",", 
            RowBox[{"s", "[", "t", "]"}], ",", "rlim", ",", "\[Lambda]", ",", 
            "inov", ",", "\[Alpha]"}], "]"}]}]}], ",", "\[IndentingNewLine]", 
        
        RowBox[{
         RowBox[{"x", "[", "0", "]"}], "\[Equal]", "x0"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"s", "[", "0", "]"}], "\[Equal]", "s0"}]}], 
       "\[IndentingNewLine]", "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"vars", "=", 
      RowBox[{"{", 
       RowBox[{"x", ",", "s"}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"solns", "=", 
      RowBox[{"Quiet", "@", 
       RowBox[{"NDSolve", "[", 
        RowBox[{"eqns", ",", "vars", ",", 
         RowBox[{"{", 
          RowBox[{"t", ",", "0", ",", "tlim"}], "}"}], ",", 
         RowBox[{"WorkingPrecision", "\[Rule]", "pg"}], ",", 
         RowBox[{"PrecisionGoal", "\[Rule]", "\[Infinity]"}]}], "]"}]}]}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{"P1", "=", 
      RowBox[{"First", "[", 
       RowBox[{
        RowBox[{"x", "[", "tlim", "]"}], "/.", "solns"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"P2", "=", 
      RowBox[{"First", "[", 
       RowBox[{
        RowBox[{"s", "[", "tlim", "]"}], "/.", "solns"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"WX", "=", 
      RowBox[{"Re", "[", 
       RowBox[{"P1", "[", 
        RowBox[{"[", "1", "]"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"WS", "=", 
      RowBox[{"Re", "[", 
       RowBox[{"P2", "[", 
        RowBox[{"[", "1", "]"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"timm", "=", "tlim"}], ";", "\[IndentingNewLine]", 
     RowBox[{"st", "=", 
      RowBox[{"\"\<    \>\"", "<>", "\[IndentingNewLine]", 
       RowBox[{"ToString", "[", 
        RowBox[{"pr", "[", 
