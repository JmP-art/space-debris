        RowBox[{"pr", "[", 
         RowBox[{"WX", ",", "20"}], "]"}], "]"}], "<>", 
       "\[IndentingNewLine]", "\"\<     \>\"", "<>", "\[IndentingNewLine]", 
       RowBox[{"ToString", "[", 
        RowBox[{"pr", "[", 
         RowBox[{"WS", ",", "20"}], "]"}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"Print", "[", "st", "]"}], ";"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"WriteLine", "[", 
      RowBox[{"filname", ",", "st"}], "]"}], ";"}]}], " ", 
   "\[IndentingNewLine]", "]"}]}]], "Input",
