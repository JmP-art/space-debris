Cell[CellGroupData[{

Cell[TextData[StyleBox["Explore Time Evolution near a specific config (Single \
or Multi Interval)",
 FontSize->20,
 FontWeight->"Bold",
 FontColor->RGBColor[0.6, 0.4, 0.2]]], "Subtitle",
 CellGroupingRules->{"GroupTogetherGrouping", 10006.},
 CellChangeTimes->{{3.969536498219874*^9, 3.9695365012672033`*^9}, {
