      RowBox[{
       RowBox[{"isilent", ">", "0"}], ",", "\[IndentingNewLine]", 
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
         "Print", "[", 
          "\"\<---------------------------------------------------------------\
--------------\>\"", "]"}], ";", "\[IndentingNewLine]", 
         RowBox[{
         "Print", "[", "\"\<  Parameters used for benefit(s) :  \>\"", "]"}], 
         ";", "\[IndentingNewLine]", 
         RowBox[{"Print", "[", 
          RowBox[{"\"\<  b    :  \>\"", ",", "b"}], "]"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"Print", "[", 
          RowBox[{
          "\"\<  \!\(\*SubscriptBox[\(s\), \(L\)]\)   :  \>\"", ",", "el"}], 
          "]"}], ";", "\[IndentingNewLine]", 
         RowBox[{"Print", "[", 
          RowBox[{
          "\"\<  \!\(\*SubscriptBox[\(s\), \(R\)]\)   :  \>\"", ",", "eh"}], 
          "]"}], ";", "\[IndentingNewLine]", 
         RowBox[{"Print", "[", 
          RowBox[{
          "\"\<  \!\(\*SubscriptBox[\(\[Beta]\), \(L\)]\)   :  \>\"", ",", 
