         "Print", "[", 
          "\"\<---------------------------------------------------------------\
--------------\>\"", "]"}], ";"}], "\[IndentingNewLine]", "}"}]}], "]"}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
      "**", "**", "**", "**", "**", "**", "**", "**", "**", "**", "**", "**", 
       "**", "**", "**", "**", "**", "**", "**", "**", "**", "**", "**", "**",
        "**", "**", "**", "**", "**", "**", "**", "**", "**", "**", "**", "**",
        "**", "**", "**", "**", "**", "**", "**", "**", "**", "**", "**", "**",
        "**", "**", "**", "**", "**"}], "******)"}], "\[IndentingNewLine]", 
     RowBox[{"Clear", "[", "eqns", "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"eqns", "=", 
      RowBox[{"{", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"x", "'"}], "[", "t", "]"}], "==", 
         RowBox[{"XDOT", "[", 
          RowBox[{
           RowBox[{"x", "[", "t", "]"}], ",", 
           RowBox[{"s", "[", "t", "]"}], ",", "b", ",", "el", ",", "eh", ",", 
           "\[Beta]low", ",", "\[Beta]high", ",", "low", ",", "high", ",", 
           "a", ",", "tauC", ",", "\[Beta]c", ",", "\[Sigma]Cost"}], "]"}]}], 
        ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"s", "'"}], "[", "t", "]"}], "\[Equal]", 
         RowBox[{"Ts", "*", 
          RowBox[{"SDOT", "[", 
           RowBox[{
            RowBox[{"x", "[", "t", "]"}], ",", 
            RowBox[{"s", "[", "t", "]"}], ",", "rlim", ",", "\[Lambda]", ",", 
            "inov", ",", "\[Alpha]"}], "]"}]}]}]}], "\[IndentingNewLine]", 
       "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"vars", "=", 
      RowBox[{"{", 
       RowBox[{"x", ",", "s"}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"tStart", "=", "0"}], ";", "\[IndentingNewLine]", 
     RowBox[{"tEnd", "=", "IntervalWidth"}], ";", "\[IndentingNewLine]", 
     RowBox[{"dt", "=", "IntervalWidth"}], ";", "\[IndentingNewLine]", 
     RowBox[{"nIntervals", "=", 
      RowBox[{"IntegerPart", "[", 
       RowBox[{
        RowBox[{"tlim", "/", "dt"}], "+", "0.5"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"sols", "=", 
      RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"xTMP", "=", "x0"}], ";", "\[IndentingNewLine]", 
     RowBox[{"sTMP", "=", "s0"}], ";", "\[IndentingNewLine]", 
     RowBox[{"Do", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"initialConditions", "=", 
         RowBox[{"{", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
            RowBox[{"x", "[", "tStart", "]"}], "\[Equal]", "xTMP"}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"s", "[", "tStart", "]"}], "\[Equal]", "sTMP"}]}], 
          "\[IndentingNewLine]", "}"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{"**", "  ", "Solve"}], " ", "for", " ", "the", " ", 
          "current", " ", "interval"}], 
         "                                                                    \
       ", "***)"}], "\[IndentingNewLine]", 
        RowBox[{"psols", "=", 
         RowBox[{"Quiet", "[", 
          RowBox[{"NDSolve", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"eqns", ",", "initialConditions"}], "}"}], ",", "vars", 
            ",", 
            RowBox[{"{", 
             RowBox[{"t", ",", "tStart", ",", "tEnd"}], "}"}], ",", 
            RowBox[{"WorkingPrecision", "\[Rule]", "pg"}], ",", 
            RowBox[{"PrecisionGoal", "\[Rule]", "\[Infinity]"}]}], "]"}], 
          "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{"**", " ", "Update"}], " ", "for", " ", "next", " ", 
          RowBox[{"interval", ":", 
           RowBox[{
           "new", " ", "initial", " ", "conditions", " ", "are", " ", "the", 
            " ", "end", " ", "values", " ", "of", " ", "the", " ", "curreent",
             " ", "interval"}]}]}], "               ", "***)"}], 
        "\[IndentingNewLine]", 
        RowBox[{"xTMP", "=", 
         RowBox[{"Flatten", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"x", "[", "tEnd", "]"}], "/.", "psols"}], ",", "i"}], 
          "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"sTMP", "=", 
         RowBox[{"Flatten", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"s", "[", "tEnd", "]"}], "/.", "psols"}], ",", "i"}], 
          "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"xTMP", "=", 
         RowBox[{"First", "[", "xTMP", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"sTMP", "=", 
         RowBox[{"First", "[", "sTMP", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{"**", " ", "Store"}], " ", "the", " ", "solution"}], 
         "                                                                    \
                    ", "***)"}], "\[IndentingNewLine]", 
        RowBox[{"AppendTo", "[", 
         RowBox[{"sols", ",", "psols"}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"tStart", "=", "tEnd"}], ";", "\[IndentingNewLine]", 
        RowBox[{"tEnd", "=", 
         RowBox[{"tEnd", "+", "dt"}]}], ";"}], "\[IndentingNewLine]", ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", "nIntervals"}], "}"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"combiSolx", "[", "t_", "]"}], ":=", 
      RowBox[{"Piecewise", "[", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"x", "[", "t", "]"}], "/.", " ", 
            RowBox[{"sols", "[", 
             RowBox[{"[", 
              RowBox[{"i", ",", "1", ",", "1"}], "]"}], "]"}]}], ",", 
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{"i", "-", "1"}], ")"}], "dt"}], "<=", "t", "<=", 
            RowBox[{"i", "*", "dt"}]}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "1", ",", "nIntervals"}], "}"}]}], "]"}], "]"}]}],
      ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"combiSols", "[", "t_", "]"}], ":=", 
      RowBox[{"Piecewise", "[", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"s", "[", "t", "]"}], "/.", " ", 
            RowBox[{"sols", "[", 
             RowBox[{"[", 
              RowBox[{"i", ",", "1", ",", "2"}], "]"}], "]"}]}], ",", 
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{"i", "-", "1"}], ")"}], "dt"}], "<=", "t", "<=", 
