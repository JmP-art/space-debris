   "isilent_", ",", "iopt_", ",", "x0_", ",", "s0_", ",", "tlim_", ",", 
    "IntervalWidth_", ",", "precgoal_"}], "]"}], ":=", 
  RowBox[{"Module", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", 
