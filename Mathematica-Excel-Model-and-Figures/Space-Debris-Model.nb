Cell[BoxData[
 RowBox[{
  RowBox[{"ExploreTimeEvolution", "[", 
   RowBox[{"itype_", ",", "i_", ",", "j_", ",", "dxs_", ",", "tlim_", ",", 
    StyleBox["dint_",
     FontColor->RGBColor[1, 0, 1]], 
    StyleBox[",",
     FontColor->RGBColor[1, 0, 1]], "precgoal_", ",", "epss_", ",", 
    "filname_"}], "]"}], ":=", 
  RowBox[{"Module", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"x0", ",", "s0", ",", "xref", ",", "sref", ",", "k", ",", "l"}], 
     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"xref", "=", 
      RowBox[{"i", "*", "dxs"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"sref", "=", 
      RowBox[{"j", "*", "dxs"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      TemplateBox[{
        Cell[
         TextData["OpenWrite"]], "paclet:ref/OpenWrite"},
       "RefLink",
       BaseStyle->{"InlineFormula"}], "[", 
      StyleBox["filname",
       FontColor->GrayLevel[0.5]], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"For", "[", 
      RowBox[{
       RowBox[{"k", "=", 
        RowBox[{"-", "1"}]}], ",", 
       RowBox[{"k", "<", "2"}], ",", 
       RowBox[{"k", "++"}], ",", "\[IndentingNewLine]", 
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"x0", " ", "=", " ", 
          RowBox[{"xref", " ", "+", " ", 
           RowBox[{"k", " ", "*", " ", "epss"}]}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"For", "[", 
          RowBox[{
           RowBox[{"l", "=", 
            RowBox[{"-", "1"}]}], ",", 
           RowBox[{"l", "<", "2"}], ",", 
           RowBox[{"l", "++"}], ",", "\[IndentingNewLine]", 
           RowBox[{"{", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"s0", " ", "=", " ", 
              RowBox[{"sref", " ", "+", " ", 
               RowBox[{"l", " ", "*", " ", "epss"}]}]}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"If", "[", " ", 
              RowBox[{
               RowBox[{"itype", "==", "1"}], ",", 
               RowBox[{"Quiet", "[", 
                RowBox[{"CellPrint", "[", 
                 RowBox[{"TextCell", "[", 
                  RowBox[{
                   RowBox[{"PlotTimeEvolution", "[", 
                    RowBox[{"0", ",", "0", ",", 
                    StyleBox["x0",
                    FontColor->RGBColor[1, 0.5, 0]], ",", 
                    StyleBox["s0",
                    FontColor->RGBColor[1, 0.5, 0]], ",", 
                    StyleBox["tlim",
                    FontColor->RGBColor[1, 0, 1]], ",", 
                    StyleBox["precgoal",
                    FontColor->RGBColor[0.5, 0, 0.5]]}], "]"}], ",", 
                   "\"\<Text\>\""}], "]"}], "]"}], "]"}]}], "]"}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"If", "[", " ", 
              RowBox[{
               RowBox[{"itype", "==", "1"}], ",", 
               RowBox[{
                RowBox[{"TimeEvolutionSingleInterval", "[", 
                 RowBox[{"0", ",", 
                  StyleBox["x0",
                   FontColor->RGBColor[1, 0.5, 0]], ",", 
                  StyleBox["s0",
                   FontColor->RGBColor[1, 0.5, 0]], ",", 
                  StyleBox["tlim",
                   FontColor->RGBColor[1, 0, 1]], ",", 
                  StyleBox["precgoal",
                   FontColor->RGBColor[0.5, 0, 0.5]], 
                  StyleBox[",",
                   FontColor->RGBColor[0.5, 0, 0.5]], 
                  StyleBox["filname",
                   FontColor->RGBColor[0.5, 0, 0.5]]}], "]"}], ";"}]}], "]"}],
              ";", "\[IndentingNewLine]", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{"itype", "==", "2"}], ",", 
               RowBox[{"Quiet", "[", 
                RowBox[{"CellPrint", "[", 
                 RowBox[{"TextCell", "[", 
                  RowBox[{
                   RowBox[{"PlotTimeEvolutionMultiInterval", "[", 
                    RowBox[{"0", ",", "0", ",", 
                    StyleBox["x0",
                    FontColor->RGBColor[1, 0.5, 0]], ",", 
                    StyleBox["s0",
                    FontColor->RGBColor[1, 0.5, 0]], ",", 
                    StyleBox["tlim",
                    FontColor->RGBColor[1, 0, 1]], ",", 
                    StyleBox["dint",
                    FontColor->RGBColor[1, 0, 1]], ",", 
                    StyleBox["precgoal",
                    FontColor->RGBColor[0.5, 0, 0.5]]}], "]"}], ",", 
                   "\"\<Text\>\""}], "]"}], "]"}], "]"}]}], "]"}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"If", "[", " ", 
              RowBox[{
               RowBox[{"itype", "==", "2"}], ",", 
               RowBox[{
                RowBox[{"TimeEvolutionMultiInterval", "[", 
